{
  "name": "chess_web",
  "private": true,
  "version": "0.0.1",
  "author": "Mauricio Lopes <mauricionlopes.dev@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "sh scripts/dev.sh",
    "watch:styles": "postcss ./src/styles/input.css -o ./target/styles/chess_web.css --watch",
    "build:styles": "postcss ./src/styles/input.css -o ./target/styles/chess_web.css",
    "build": "npm run build:styles && cargo leptos build --release",
    "start": "npm run build && ./target/release/chess_web",
    "clean": "cargo clean"
  },
  "dependencies": {
    "cssnano": "^6.0.1",
    "postcss": "^8.4.24",
    "postcss-at-rules-variables": "^0.3.0",
    "postcss-cli": "^10.1.0",
    "postcss-each": "^1.1.0",
    "postcss-for": "^2.1.1",
    "postcss-import": "^15.1.0",
    "tailwindcss": "^3.3.2"
  }
}
